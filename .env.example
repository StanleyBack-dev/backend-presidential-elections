# Copie para .env.development (local). Em produção configure as variáveis na Vercel.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Neon: Dashboard > Connection Details > Connection string (use o branch "dev" localmente)
DATABASE_URL=postgresql://user:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DB_SSL=true
# Migrations rodam automaticamente ao iniciar o servidor
DB_MIGRATIONS_RUN=true
TYPEORM_LOGGING=false

# Segredos (>= 32 caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# CPF_HASH_SECRET NUNCA deve mudar depois que a votação começar (perde o controle de quem já votou).
CPF_HASH_SECRET=
# Mesmo valor configurado no BFF (frontend/server)
INTERNAL_API_SECRET=

# Cloudflare Turnstile (gratuito). Obrigatório em produção; vazio desativa localmente.
TURNSTILE_SECRET_KEY=

# local = apenas dígitos verificadores | cpfhub = confirma CPF + data de nascimento
CPF_VERIFICATION_PROVIDER=local
CPFHUB_API_KEY=

VOTING_OPEN=true
# Encerramento oficial: 17h de Brasília, mesmo instante em todos os estados.
# Sempre com fuso explícito (-03:00), senão o servidor (UTC) encerraria 3h antes.
VOTING_CLOSES_AT=2026-10-25T17:00:00-03:00
RESULTS_CACHE_TTL_SECONDS=10

# Rate limit (segundos / requisições por IP)
RATE_LIMIT_DEFAULT_TTL=60
RATE_LIMIT_DEFAULT_LIMIT=120
RATE_LIMIT_VOTE_TTL=600
RATE_LIMIT_VOTE_LIMIT=10
VOTE_FAILURE_MAX_ATTEMPTS=5
VOTE_FAILURE_LOCK_SECONDS=1800
